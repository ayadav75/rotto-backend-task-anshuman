# Either PROXY_URL or the three PROXY_* parts
PROXY_URL=
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=
DATABASE_URL=postgresql://crawler:crawler@postgres:5432/jobs
CRAWL_MAX_MINUTES=0
CRAWL_MAX_GB=0
CRAWL_MAX_REQUESTS_PER_BOARD=0
# Per-board cap on stored jobs (0 = unlimited) and concurrent detail fetches per board
CRAWL_MAX_JOBS_PER_BOARD=0
# CRAWL_WORKERS=8   (or CRAWL_WORKERS_REED / _LINKEDIN / _INDEED; defaults 8 / 8 / 4)
# Give up on a board after this many consecutive failed/blocked requests (proxy down, hard block)
CRAWL_MAX_FAIL_STREAK=40
